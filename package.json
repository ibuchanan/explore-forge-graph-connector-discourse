{
  "name": "explore-forge-graph-connector-discourse",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "build": "npm run generate:types && tsc -p tsconfig.json",
    "changelog": "git cliff",
    "check": "lefthook run pre-push",
    "clean": "rm -rf ./node_modules ./dist ./src/discourse/api",
    "forge:deploy": "bash ./scripts/env-var.sh 'forge deploy --environment \"$FORGE_ENVIRONMENT\"'",
    "forge:install": "bash ./scripts/env-var.sh 'forge install --site \"$FORGE_SITE\" --product \"$FORGE_PRODUCT\" --environment \"$FORGE_ENVIRONMENT\" --non-interactive'",
    "forge:logs": "forge logs | sd \"^[^{]*\" \"\" | jq .",
    "forge:register": "forge register",
    "forge:uninstall": "bash ./scripts/env-var.sh 'forge uninstall --site \"$FORGE_SITE\" --product \"$FORGE_PRODUCT\" --environment \"$FORGE_ENVIRONMENT\"'",
    "forge:upgrade": "bash ./scripts/env-var.sh 'forge install --upgrade --site \"$FORGE_SITE\" --product \"$FORGE_PRODUCT\" --environment \"$FORGE_ENVIRONMENT\" --non-interactive'",
    "format": "lefthook run format",
    "format:biome": "biome format --write",
    "format:check": "biome format",
    "format:scripts": "shfmt -w scripts/*.sh",
    "generate:types": "openapi-typescript",
    "lint": "lefthook run lint",
    "lint:check": "biome lint",
    "lint:fix": "biome lint --write",
    "lint:forge": "bash ./scripts/env-var.sh 'forge lint'",
    "lint:prelint": "ast-grep scan --config node_modules/@forge-ahead/prelint/sgconfig.ecosol.yml --globs '!node_modules/**' --globs '!vendor/**'",
    "lint:scripts": "shellcheck scripts/*.sh",
    "prepare": "lefthook install",
    "size": "npm run build && size-limit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "todo": "rg --glob '!vendor/**' --glob '!package.json' 'TODO' || echo 'No TODOs found!'",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit"
  },
  "dependencies": {
    "@forge-ahead/errors": "github:ibuchanan/forge-ahead-errors",
    "@forge-ahead/logging": "github:ibuchanan/forge-ahead-logging",
    "@forge/api": "^8.4",
    "@forge/kvs": "^2.1",
    "@forge/teamwork-graph": "^5.3",
    "openapi-fetch": "^0.17"
  },
  "devDependencies": {
    "@ast-grep/cli": "^0.51",
    "@biomejs/biome": "2.6.3",
    "@forge-ahead/prelint": "github:ibuchanan/tool-forge-prelint-ast-grep",
    "@size-limit/file": "^14.3",
    "@types/node": "24",
    "archunit": "^2.5",
    "git-cliff": "^2.14",
    "lefthook": "^2.2",
    "openapi-typescript": "^7.13",
    "size-limit": "^14.3",
    "typescript": "^5.9",
    "vitest": "^5.0",
    "yaml": "^2.9"
  },
  "engines": {
    "node": "24.x"
  },
  "size-limit": [
    {
      "name": "Forge app bundle",
      "path": [
        "dist/**/*.js"
      ],
      "limit": "10 kB"
    }
  ]
}
